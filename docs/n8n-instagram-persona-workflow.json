    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json.output ?? $json;\nif (!payload.voice || !Array.isArray(payload.caption_templates) || !Array.isArray(payload.hashtag_clusters)) {\n  throw new Error('Editorial branch output is missing expected fields.');\n}\nif (payload.caption_templates.length !== 9) {\n  throw new Error('Editorial branch must produce exactly 9 caption templates.');\n}\nreturn {\n  json: {\n    branch: 'editorial',\n    validation_status: 'ok',\n    ...payload\n  }\n};"
