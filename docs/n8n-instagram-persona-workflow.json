      "id": "778429ba-7a18-46fe-8101-7cb4299de8f0",
      "name": "Bundle Creator Branches"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst bundle = {};\nfor (const item of items) {\n  bundle[item.json.branch] = item.json;\n}\nconst required = ['profile', 'visual', 'editorial'];\nconst missing = required.filter((key) => !bundle[key]);\nif (missing.length) {\n  throw new Error('Missing branches: ' + missing.join(', '));\n}\nconst starterPosts = bundle.visual.starter_grid_prompts.map((prompt, index) => ({\n  slot: index + 1,\n  image_prompt: prompt,\n  caption: bundle.editorial.caption_templates[index] ?? '',\n  hashtag_cluster: bundle.editorial.hashtag_clusters[index % bundle.editorial.hashtag_clusters.length] ?? ''\n}));\nreturn [{\n  json: {\n    status: 'draft_ready',\n    profile: bundle.profile,\n    visual: bundle.visual,\n    editorial: bundle.editorial,\n    starter_posts: starterPosts\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        0
      ],
      "id": "e7f8b799-22fa-481a-bcb8-2997d9affb3a",
      "name": "Create Creator Package"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    ...$json,\n    provider: 'replace_with_image_api',\n    request_payload: {\n      avatar_prompt: $json.visual.avatar_prompt,\n      starter_posts: $json.starter_posts,\n      note: 'Replace this placeholder with HTTP Request or a queue node for your image provider.'\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "75867d44-4dd2-42e3-bd69-0f2f2e185482",
      "name": "Prepare Image Generation Request"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json;\nconst profile = payload.profile ?? {};\nconst disclosurePolicy = 'clear';\nif (!profile.disclosure_line && disclosurePolicy === 'clear') {\n  throw new Error('Missing disclosure line for a synthetic/original fictional persona.');\n}\nconst textBlob = JSON.stringify(payload).toLowerCase();\nconst blockedTerms = ['celebrity clone', 'looks exactly like', 'same as this real person', 'copy this influencer'];\nfor (const term of blockedTerms) {\n  if (textBlob.includes(term)) {\n    throw new Error('Compliance gate blocked a mimic or impersonation signal: ' + term);\n  }\n}\nreturn {\n  json: {\n    ...payload,\n    compliance_status: 'passed'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1370,
        0
      ],
      "id": "db57f1f8-d82c-45bf-ba35-69d3567ef4dd",
      "name": "Compliance Gate"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    ...$json,\n    queue_status: 'ready_for_manual_review',\n    publish_payload: {\n      platform: 'instagram',\n      status: $json.compliance_status,\n      profile: $json.profile,\n      starter_posts: $json.starter_posts\n    }\n  }\n};"
      },
