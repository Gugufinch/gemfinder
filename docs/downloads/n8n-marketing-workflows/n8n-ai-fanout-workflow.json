    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst bundle = {};\nlet meta = null;\nfor (const item of items) {\n  if (item.json.branch) {\n    bundle[item.json.branch] = item.json;\n    continue;\n  }\n  meta = {\n    campaign_brief: item.json.campaign_brief,\n    product_name: item.json.product_name,\n    target_audience: item.json.target_audience,\n    campaign_goal: item.json.campaign_goal,\n    platform: item.json.platform,\n    visual_mode: item.json.visual_mode,\n    identity_mode: item.json.identity_mode\n  };\n}\nconst required = ['sales', 'marketing', 'product'];\nconst missing = required.filter((key) => !bundle[key]);\nif (!meta) {\n  throw new Error('Campaign metadata item is missing from the merge.');\n}\nif (missing.length) {\n  throw new Error('Missing branches: ' + missing.join(', '));\n}\nconst targetAssetCount = Math.max(\n  bundle.product.image_prompt_templates?.length ?? 0,\n  bundle.marketing.caption_angles?.length ?? 0,\n  6\n);\nreturn [{\n  json: {\n    strategy_status: 'ready_for_production',\n    campaign_meta: meta,\n    sales: bundle.sales,\n    marketing: bundle.marketing,\n    product: bundle.product,\n    creative_targets: {\n      asset_count: targetAssetCount,\n      platform: meta.platform\n    },\n    next_step: 'Pass this item into the Creative Production sub-workflow.'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
