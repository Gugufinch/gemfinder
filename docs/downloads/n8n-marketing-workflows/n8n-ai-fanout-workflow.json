        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json.output ?? $json;\nif (!payload.visual_style || !Array.isArray(payload.scene_concepts) || !Array.isArray(payload.image_prompt_templates)) {\n  throw new Error('Product branch output is missing expected fields.');\n}\nif (payload.image_prompt_templates.length < 6) {\n  throw new Error('Product branch should produce at least 6 image prompt templates.');\n}\nreturn {\n  json: {\n    branch: 'product',\n    validation_status: 'ok',\n    ...payload\n  }\n};"
